# Frontend
# Optional. Use only when the API is hosted on another origin.
VITE_ENABLE_AFFILIATE_EMBEDS=true
# Keep true to show actual affiliate iframes/widgets. Set false only if partner scripts cause layout or console problems.
VITE_API_URL=https://your-backend-url.example.com

# Backend / PHP API
TURSO_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token
NEWS_API_KEY=your_gnews_api_key
ADMIN_TOKEN=change_this_admin_secret
ENABLE_NEWS_CRON=false
CRON_SCHEDULE=0 * * * *
VITE_DEBUG_CLIENT=false
